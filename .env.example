# Copia este archivo como .env y cambia las contraseñas.
# Solo letras y números en las contraseñas (sin comillas, espacios ni $).
# .env está en .gitignore: nunca se sube al repo.

STACK_VERSION=8.19.23
CLUSTER_NAME=siem-grupo5

# Usuario elastic (superusuario). Con este entras a Kibana.
ELASTIC_PASSWORD=CambiaEsto123
# Usuario interno kibana_system
KIBANA_PASSWORD=CambiaEsto456
# Usuario logstash_internal (solo puede escribir en logs-siem.*)
LOGSTASH_PASSWORD=CambiaEsto789
# Mínimo 32 caracteres. Necesaria para las reglas de detección.
KIBANA_ENCRYPTION_KEY=cambia-esta-llave-de-32-caracteres-o-mas

# Memoria. Con 16 GB o más en el PC sirven estos valores.
ES_HEAP=1g
ES_MEM_LIMIT=2g
KB_MEM_LIMIT=1536m
LS_HEAP=512m
LS_MEM_LIMIT=1g

# Usuarios de laboratorio de la víctima.
# La de admin es débil a propósito: está en atacante/claves.txt para que hydra la encuentre.
VICTIMA_ADMIN_PASSWORD=sunshine2024
VICTIMA_OPERADOR_PASSWORD=Operador2026Lab

{
  "policy": {
    "_meta": { "descripcion": "La misma política que siem-30d pero en minutos, para mostrar hot -> warm -> cold en vivo (scripts/demo-ilm.sh)" },
    "phases": {
      "hot": {
        "min_age": "0ms",
        "actions": {
          "rollover": { "max_age": "1m" },
          "set_priority": { "priority": 100 }
        }
      },
      "warm": {
        "min_age": "2m",
        "actions": {
          "forcemerge": { "max_num_segments": 1 },
          "set_priority": { "priority": 50 }
        }
      },
      "cold": {
        "min_age": "4m",
        "actions": {
          "set_priority": { "priority": 0 }
        }
      },
      "delete": {
        "min_age": "30m",
        "actions": { "delete": {} }
      }
    }
  }
}

{
  "rule_id": "siem-g5-escaneo-puertos",
  "name": "SIEM - Escaneo de puertos",
  "description": "Una IP se conecta a 10 o más puertos distintos de la víctima en 90 segundos (puertos señuelo de portguard).",
  "type": "threshold",
  "index": [
    "logs-siem.red-*"
  ],
  "query": "event.action : \"conexion_puerto\"",
  "threshold": {
    "field": [
      "source.ip"
    ],
    "value": 1,
    "cardinality": [
      {
        "field": "destination.port",
        "value": 10
      }
    ]
  },
  "severity": "medium",
  "risk_score": 47,
  "tags": [
    "SIEM",
    "Red",
    "Escaneo",
    "R8.4"
  ],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0007",
        "name": "Discovery",
        "reference": "https://attack.mitre.org/tactics/TA0007/"
      },
      "technique": [
        {
          "id": "T1046",
          "name": "Network Service Discovery",
          "reference": "https://attack.mitre.org/techniques/T1046/"
        }
      ]
    }
  ],
  "enabled": true,
  "language": "kuery",
  "interval": "30s",
  "from": "now-90s",
  "author": [
    "Grupo 5"
  ],
  "license": "MIT",
  "version": 1,
  "max_signals": 100
}

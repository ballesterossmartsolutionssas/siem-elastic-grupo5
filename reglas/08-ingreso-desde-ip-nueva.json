{
  "rule_id": "siem-g5-ingreso-desde-ip-nueva",
  "name": "SIEM - Ingreso desde una IP nueva",
  "description": "Detección de anomalías (new terms): ingreso SSH exitoso con una combinación de usuario e IP que no se había visto en los últimos 7 días. Aprende la línea base sola y no necesita umbrales. Playbook: docs/playbooks/fuerza-bruta-ssh.md",
  "type": "new_terms",
  "index": [
    "logs-siem.auth-*"
  ],
  "language": "kuery",
  "query": "event.action : \"ssh_login\" and event.outcome : \"success\"",
  "new_terms_fields": [
    "user.name",
    "source.ip"
  ],
  "history_window_start": "now-7d",
  "severity": "medium",
  "risk_score": 55,
  "tags": [
    "SIEM",
    "SSH",
    "Anomalía",
    "R8.4"
  ],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0001",
        "name": "Initial Access",
        "reference": "https://attack.mitre.org/tactics/TA0001/"
      },
      "technique": [
        {
          "id": "T1078",
          "name": "Valid Accounts",
          "reference": "https://attack.mitre.org/techniques/T1078/"
        }
      ]
    }
  ],
  "enabled": true,
  "interval": "30s",
  "from": "now-90s",
  "author": [
    "Grupo 5"
  ],
  "license": "MIT",
  "version": 1,
  "max_signals": 100
}
